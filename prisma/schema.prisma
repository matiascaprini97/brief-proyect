datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id             String   @id @default(uuid())
  role           Role     @default(CLIENT)
  username       String   @unique
  password       String
  email          String   @unique
  firstName      String?
  lastName       String?
  phoneNumber    String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales          Sale[]

  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
}

model Product {
  id                  String   @id @default(uuid())
  brand               String
  name                String
  details             String   @db.Text
  photos              String[]
  spareParts          String?  // Guarda el JSON de repuestos asociados si es un Equipo
  warrantyDays        Int      @default(365) 
  
  // 👈 NUEVOS CAMPOS PARA CLASIFICACIÓN
  isSpare             Boolean  @default(false)         // Si es true, es un repuesto. Si es false, es un equipo.
  defaultLifespanDays Int      @default(180)           // Vida útil sugerida por defecto si es repuesto.
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sales               Sale[]
  trackedAsSpare      TrackedSparePart[] 
}

model Sale {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  trackedSpareParts TrackedSparePart[]

  @@index([userId])
  @@index([productId])
}

model TrackedSparePart {
  id             String   @id @default(uuid())
  saleId         String
  name           String   
  spareProductId String?  
  installedAt    DateTime @default(now()) 
  lifespanDays   Int      @default(180)   

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  spareProduct   Product? @relation(fields: [spareProductId], references: [id], onDelete: SetNull)

  @@index([saleId])
}