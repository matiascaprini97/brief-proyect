datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  SYSTEM
}

model User {
  id             String   @id @default(uuid())
  role           Role     @default(CLIENT)
  username       String   @unique
  password       String
  email          String   @unique
  firstName      String?
  lastName       String?
  phoneNumber    String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales         Sale[]
  notifications Notification[] // 👈 Relación con sus notificaciones

  resetToken       String?   @unique
  resetTokenExpiry DateTime?
}

model Product {
  id                  String   @id @default(uuid())
  brand               String
  name                String
  details             String   @db.Text
  photos              String[]
  spareParts          String?
  warrantyDays        Int      @default(365)
  isSpare             Boolean  @default(false)
  defaultLifespanDays Int      @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales          Sale[]
  trackedAsSpare TrackedSparePart[]
}

model Sale {
  id         String   @id @default(uuid())
  userId     String
  productId  String
  invoiceUrl String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  trackedSpareParts TrackedSparePart[]

  @@index([userId])
  @@index([productId])
}

model TrackedSparePart {
  id             String   @id @default(uuid())
  saleId         String
  name           String
  spareProductId String?
  installedAt    DateTime @default(now())
  lifespanDays   Int      @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  spareProduct Product? @relation(fields: [spareProductId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

// 👈 NUEVA TABLA DE NOTIFICACIONES
model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           @db.Text
  link      String?
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}