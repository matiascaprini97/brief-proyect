datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id             String   @id @default(uuid())
  role           Role     @default(CLIENT)
  username       String   @unique
  password       String
  email          String   @unique
  firstName      String?
  lastName       String?
  phoneNumber    String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales          Sale[]
}

model Product {
  id             String   @id @default(uuid())
  brand          String
  name           String
  details        String   @db.Text
  photos         String[]
  spareParts     String?  
  warrantyDays   Int      @default(365) // 👈 NUEVO: Días de garantía (ej: 365 = 1 año, 730 = 2 años)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales          Sale[]
  trackedAsSpare TrackedSparePart[] 
}

model Sale {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  trackedSpareParts TrackedSparePart[]

  @@index([userId])
  @@index([productId])
}

model TrackedSparePart {
  id             String   @id @default(uuid())
  saleId         String
  name           String   
  spareProductId String?  
  installedAt    DateTime @default(now()) 
  lifespanDays   Int      @default(180)   

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  spareProduct   Product? @relation(fields: [spareProductId], references: [id], onDelete: SetNull)

  @@index([saleId])
}